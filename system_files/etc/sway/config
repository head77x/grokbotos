# Grok Bot OS kiosk. No panel, no desktop, no window chrome.
# tty1 autologins grokbot, whose shell execs sway, which runs grokbot-kiosk.
# grokbot-kiosk restarts grokbot-launch whenever that process exits.
# sway itself does not restart a crashed exec child.
#
# The visible app is whatever grokbot-launch starts. The native Grok Bot
# RPM's desktop file sets StartupWMClass=grok-bot, and app.conf sets
# GROKBOT_APP_ID=grok-bot so Super+G / Alt+G can focus it. The placeholder
# Firefox window uses app_id firefox. Apps open maximized on their own workspace.
# fuzzel is a layer-shell launcher, so it is not a window and is not
# covered by the fullscreen rule.
#
# Keybindings (Alt as well as Super): some VM consoles, including UTM,
# do not forward the Super key. Alt+Tab / Alt+F4 are the fallbacks that
# were added after a real kiosk boot left the user with no way to move
# or close a window (docs/DECISIONS.md, 2026-07-11 and 2026-07-13).
#
# Logs: this process's stdout/stderr, including the app it launches.
# Read them from another VT: cat ~grokbot/.local/share/grokbot/shell.log

# Wallpaper: grokbot-desktop runs swaybg from /etc/grokbot/desktop.conf
# (user override via grokbot-wallpaper). No `output background` here, or
# sway would start a second swaybg. Never any desktop icons.
# grokbotd (systemd user service) gets the session environment so
# system.info can report it. It finds the sway IPC socket on its own.
# Night light (gammastep) starts after that, if it is turned on.
exec sh -c 'systemctl --user import-environment WAYLAND_DISPLAY SWAYSOCK XDG_DATA_DIRS XMODIFIERS QT_IM_MODULE SDL_IM_MODULE; systemctl --user start grokbot-nightlight.service'
exec /usr/local/bin/grokbot-desktop >>"$HOME/.local/share/grokbot/desktop.log" 2>&1

exec sh -c 'mkdir -p "$HOME/.local/share/grokbot" "$HOME/Apps" "$HOME/.local/share/applications" && exec /usr/local/bin/grokbot-kiosk >>"$HOME/.local/share/grokbot/shell.log" 2>&1'

default_border none
default_floating_border none
hide_edge_borders both
# Design system (docs/DESIGN.md): a quiet frame around each app, jet
# colours, the accent only where focus is. A single maximized window keeps
# no border (hide_edge_borders), so this only shows with splits/floats.
gaps inner 6
gaps outer 4
smart_gaps off
#                        border    background text      indicator child_border
client.focused           #64b5ff   #18181b    #f2f2f2   #64b5ff   #64b5ff
client.focused_inactive  #2a2a2e   #121214    #a3a3a3   #2a2a2e   #2a2a2e
client.unfocused         #1c1c1f   #0a0a0b    #8a8a8a   #1c1c1f   #1c1c1f
client.urgent            #e8a33d   #18181b    #f2f2f2   #e8a33d   #e8a33d

bar {
    mode invisible
}

# Windows are not fullscreen: docks are layer-shell panels with exclusive
# zones, and a fullscreen view would cover them. Instead every app opens
# on its own workspace (grokbot-run / grokbot-dock), where a single tiled
# window fills the area the docks leave free, i.e. it is "maximized".
# Grok Bot always lives on workspace 1 and is the first thing on screen.
assign [app_id="grok-bot"] workspace number 1
workspace_layout default

# No desktop icons, ever. The only app surfaces are the docks
# (/etc/grokbot/dock.conf, grokbot-dock-config) and the fuzzel launcher.
exec /usr/local/bin/grokbot-dock >>"$HOME/.local/share/grokbot/dock.log" 2>&1

bindsym Mod4+space exec /usr/local/bin/grokbot-switch
bindsym Mod1+space exec /usr/local/bin/grokbot-switch
bindsym Mod4+g exec /usr/local/bin/grokbot-focus
bindsym Mod1+g exec /usr/local/bin/grokbot-focus
# Alt+Tab cycles every window across workspaces.
# Wi-Fi / network setup (nmtui in a terminal). Works before Grok Bot sign-in.
bindsym Mod4+n exec /usr/local/bin/grokbot-wifi
bindsym Mod1+n exec /usr/local/bin/grokbot-wifi
# Screen lock and idle (grokbot-idle: screen off 5 min, lock 10 min,
# lock before sleep). Without a PIN, grokbot-lock opens the PIN setup.
exec /usr/local/bin/grokbot-idle >>"$HOME/.local/share/grokbot/idle.log" 2>&1
exec /usr/local/bin/grokbot-lock --first-boot
for_window [app_id="grokbot-lock-setup"] floating enable, resize set 720 360, move position center, focus
for_window [app_id="grokbot-settings"] fullscreen disable
# Installed web apps (grokbot-webapp): normal tiled app windows, never fullscreen.
for_window [app_id="^grokbot-webapp-"] fullscreen disable
for_window [app_id=".*"] inhibit_idle fullscreen
bindsym Mod4+l exec /usr/local/bin/grokbot-lock
bindsym Mod1+l exec /usr/local/bin/grokbot-lock
# Volume, brightness and media keys, also on the lock screen (--locked).
# grokbot-osd shows a wob bar.
exec /usr/local/bin/grokbot-osd --serve >>"$HOME/.local/share/grokbot/osd.log" 2>&1
bindsym --locked XF86AudioRaiseVolume exec /usr/local/bin/grokbot-volume up
bindsym --locked XF86AudioLowerVolume exec /usr/local/bin/grokbot-volume down
bindsym --locked XF86AudioMute exec /usr/local/bin/grokbot-volume mute
bindsym --locked XF86AudioMicMute exec /usr/local/bin/grokbot-volume mic-mute
bindsym --locked XF86MonBrightnessUp exec /usr/local/bin/grokbot-brightness up
bindsym --locked XF86MonBrightnessDown exec /usr/local/bin/grokbot-brightness down
# Media keys go to the web app waiting on media.keys.wait (Media player), else playerctl.
bindsym --locked XF86AudioPlay exec /usr/local/bin/grokbot-os media-key play-pause
bindsym --locked XF86AudioPause exec /usr/local/bin/grokbot-os media-key play-pause
bindsym --locked XF86AudioNext exec /usr/local/bin/grokbot-os media-key next
bindsym --locked XF86AudioPrev exec /usr/local/bin/grokbot-os media-key previous
bindsym --locked XF86AudioStop exec /usr/local/bin/grokbot-os media-key stop
# Hovering focuses a window, so the first click on it reaches the app
# instead of only moving focus (seen with Firefox app windows).
focus_follows_mouse yes
# Notifications (mako, top right). Super+Shift+N / Alt+Shift+N: Do Not Disturb.
exec /usr/local/bin/grokbot-notify --serve >>"$HOME/.local/share/grokbot/notify.log" 2>&1
bindsym Mod4+Shift+n exec /usr/local/bin/grokbot-notify-dnd toggle
bindsym Mod1+Shift+n exec /usr/local/bin/grokbot-notify-dnd toggle
# Screenshots: Print = whole screen, Shift+Print = region. Saved to
# ~/Pictures/Screenshots and copied to the clipboard.
bindsym Print exec /usr/local/bin/grokbot-capture full
bindsym Shift+Print exec /usr/local/bin/grokbot-capture region
# Korean input: fcitx5 (한/영, Shift+Space, Right Alt). Config /etc/xdg/fcitx5.
exec fcitx5 -d --replace >>"$HOME/.local/share/grokbot/fcitx5.log" 2>&1
bindsym Mod1+Tab exec /usr/lib/grokbot/grokbot-alttab.py next
bindsym Mod1+Shift+Tab exec /usr/lib/grokbot/grokbot-alttab.py prev
# Close the focused window. Grok Bot is restarted by grokbot-kiosk.
bindsym Mod1+F4 kill
bindsym Mod4+q kill

# Keyboard layout chosen in Settings > Keyboard (grokbotd keyboard.layout.set);
# grokbot-session creates it empty.
include ~/.config/grokbot/keyboard.conf

# Per-output scale / position / mode saved by Settings > Display (grokbotd
# display.set). Last, so a problem in it cannot skip anything above;
# grokbot-session creates it empty.
include ~/.config/grokbot/outputs.conf
